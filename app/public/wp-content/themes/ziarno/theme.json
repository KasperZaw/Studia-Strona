{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Krem (tło)", "color": "#FBF7F1" },
				{ "slug": "contrast", "name": "Espresso (tekst)", "color": "#2A1C14" },
				{ "slug": "accent-1", "name": "Rdzawy brąz", "color": "#8A4520" },
				{ "slug": "accent-2", "name": "Latte", "color": "#F1E6D6" },
				{ "slug": "accent-3", "name": "Butelkowa zieleń", "color": "#1E4D3E" },
				{ "slug": "accent-4", "name": "Ciepła szarość", "color": "#5E5049" },
				{ "slug": "accent-5", "name": "Biel", "color": "#FFFFFF" },
				{ "slug": "accent-6", "name": "Linia", "color": "#D9C9B4" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Manrope-VariableFont_wght.woff2" ]
						}
					]
				},
				{
					"name": "Literata",
					"slug": "literata",
					"fontFamily": "Literata, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Literata72pt-Regular.woff2" ] },
						{ "fontFamily": "Literata", "fontStyle": "italic", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Literata72pt-RegularItalic.woff2" ] },
						{ "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Literata72pt-SemiBold.woff2" ] },
						{ "fontFamily": "Literata", "fontStyle": "normal", "fontWeight": "700", "fontDisplay": "swap", "src": [ "file:./assets/fonts/Literata72pt-Bold.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Mały", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Średni", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "large", "name": "Duży", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Bardzo duży", "size": "2rem", "fluid": { "min": "1.6rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Ogromny", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.75rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|manrope",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|literata",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				},
				"color": { "text": "var:preset|color|contrast" }
			},
			"link": {
				"color": { "text": "var:preset|color|accent-1" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|contrast" },
					"typography": { "textDecoration": "underline" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|base"
				},
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "700" },
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|literata",
					"fontWeight": "700",
					"fontSize": "var:preset|font-size|large"
				},
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontWeight": "600", "fontSize": "var:preset|font-size|medium" },
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|contrast" },
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/table": {
				"border": { "color": "var:preset|color|accent-6" }
			},
			"core/separator": {
				"color": { "text": "var:preset|color|accent-6" }
			},
			"core/quote": {
				"typography": { "fontFamily": "var:preset|font-family|literata", "fontStyle": "italic", "fontSize": "var:preset|font-size|large" },
				"border": { "left": { "color": "var:preset|color|accent-1", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "var:preset|spacing|40" } }
			}
		}
	}
}
